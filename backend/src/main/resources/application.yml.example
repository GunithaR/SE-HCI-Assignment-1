server:
  port: 8080
  servlet:
    context-path: /

spring:
  # ── DataSource ──────────────────────────────────────────────────────────────
  datasource:
    url: jdbc:mysql://localhost:3306/construction_platform?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
    username: YOUR_MYSQL_USERNAME       # ← replace
    password: YOUR_MYSQL_PASSWORD       # ← replace
    driver-class-name: com.mysql.cj.jdbc.Driver

  # ── JPA / Hibernate ─────────────────────────────────────────────────────────
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  # ── Multipart file upload ────────────────────────────────────────────────
  servlet:
    multipart:
      enabled: true
      max-file-size: 10MB
      max-request-size: 12MB

  # ── Jackson ─────────────────────────────────────────────────────────────────
  jackson:
    serialization:
      write-dates-as-timestamps: false

# ── File uploads & Seeder ────────────────────────────────────────────────────
app:
  upload:
    dir: uploads/products
  seed:
    admin-email: admin@platform.com
    admin-password: YOUR_ADMIN_PASSWORD  # ← replace

# ── JWT ────────────────────────────────────────────────────────────────────────
jwt:
  # Generate a strong 256-bit Base64-encoded secret key for production
  secret: "YOUR_BASE64_ENCODED_SECRET_KEY"  # ← replace
  expiration-ms: 86400000   # 24 hours

# ── Logging ──────────────────────────────────────────────────────────────────
logging:
  level:
    org.springframework.security: INFO
    com.constructionplatform: DEBUG

# ── Logging ───────────────────────────────────────────────────────────────────
logging:
  level:
    org.springframework.security: INFO
    com.constructionplatform: DEBUG
