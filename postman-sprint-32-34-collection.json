{
  "info": {
    "name": "SE-HCI Sprint 32 and 34 API Tests",
    "_postman_id": "8e9f9b3d-4d9b-4a1a-9c49-3d8a8e4b9f71",
    "description": "Postman collection for Sprint 32 (Rule Structure) and Sprint 34 (Product Scoring).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@platform.com" },
    { "key": "adminPassword", "value": "Admin@1234" },
    { "key": "ruleId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property(\"token\");",
                  "pm.collectionVariables.set(\"token\", data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Sprint 32 - Rule Structure",
      "item": [
        {
          "name": "Create Rule",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Low Budget Rule\",\n  \"description\": \"Boost score when user budget is economy\",\n  \"ruleType\": \"SOFT_PREFERENCE\",\n  \"ruleStatus\": \"ACTIVE\",\n  \"targetScope\": \"GLOBAL\",\n  \"combinationType\": \"ALL\",\n  \"priority\": 10,\n  \"weight\": 2,\n  \"effectType\": \"ADD_SCORE\",\n  \"effectValue\": 5,\n  \"conditions\": [\n    {\n      \"operandSource\": \"USER_INPUT\",\n      \"attributeName\": \"budget\",\n      \"operator\": \"EQUALS\",\n      \"expectedValue\": \"economy\"\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property(\"id\");",
                  "pm.collectionVariables.set(\"ruleId\", data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Rules",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules"]
            }
          }
        },
        {
          "name": "Get Rule By Id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules/{{ruleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules", "{{ruleId}}"]
            }
          }
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules/{{ruleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules", "{{ruleId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Low Budget Rule Updated\",\n  \"description\": \"Updated rule\",\n  \"ruleType\": \"SOFT_PREFERENCE\",\n  \"ruleStatus\": \"ACTIVE\",\n  \"targetScope\": \"GLOBAL\",\n  \"combinationType\": \"ALL\",\n  \"priority\": 12,\n  \"weight\": 3,\n  \"effectType\": \"ADD_SCORE\",\n  \"effectValue\": 6,\n  \"conditions\": [\n    {\n      \"operandSource\": \"USER_INPUT\",\n      \"attributeName\": \"budget\",\n      \"operator\": \"EQUALS\",\n      \"expectedValue\": \"economy\"\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Toggle Rule Status Inactive",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules/{{ruleId}}/status?status=INACTIVE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules", "{{ruleId}}", "status"],
              "query": [
                { "key": "status", "value": "INACTIVE" }
              ]
            }
          }
        },
        {
          "name": "Get Active Rules",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/rules/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "rules", "active"]
            }
          }
        }
      ]
    },
    {
      "name": "Sprint 34 - Product Scoring",
      "item": [
        {
          "name": "Get Question Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/questions/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "questions", "categories"]
            }
          }
        },
        {
          "name": "Get Questions By Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/questions/Roofing Solution",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "questions", "Roofing Solution"]
            }
          }
        },
        {
          "name": "Generate Recommendations (Main Sprint 34)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/public/recommendations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "recommendations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Roofing Solution\",\n  \"answers\": {\n    \"budget\": \"economy\",\n    \"location\": \"coastal\",\n    \"style\": \"modern\",\n    \"maintenance\": \"low\",\n    \"concern\": \"long-lasting\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.expect(Array.isArray(data)).to.eql(true);",
                  "if (data.length > 0) {",
                  "  pm.expect(data[0]).to.have.property(\"totalScore\");",
                  "  pm.expect(data[0]).to.have.property(\"strategyScores\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Legacy Recommendation Endpoint",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/public/recommendations?budgetLevel=LOW&climate=TROPICAL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "public", "recommendations"],
              "query": [
                { "key": "budgetLevel", "value": "LOW" },
                { "key": "climate", "value": "TROPICAL" }
              ]
            }
          }
        }
      ]
    }
  ]
}
